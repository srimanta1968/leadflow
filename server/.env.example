# Environment Configuration for EXPRESS
# Generated for LeadFlow
# Copy this file to .env and configure your values

# ============================================
# APPLICATION CONFIGURATION
# ============================================

NODE_ENV=development
# 3010 rather than the usual 3000: on a machine also running the ProjexCloud dev
# stack, 3000/3001/3002/3099/3100/3200 are already taken. If you change this, move
# the client's proxy target with it (VITE_API_TARGET) or /api resolves to nothing.
PORT=3010
APP_NAME=LeadFlow
API_PREFIX=/api
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION (POSTGRESQL)
# ============================================
# These defaults work with docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadflow_db
DB_USER=postgres
DB_PASSWORD=postgres

# Connection string (alternative to individual vars)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# EXPRESS SPECIFIC
# ============================================
# Express.js Settings
BODY_PARSER_LIMIT=10mb
TRUST_PROXY=false

# ============================================
# SECURITY & AUTHENTICATION
# ============================================

JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3010
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true

# ============================================
# PROJEXCLOUD SDK GATEWAY
# ============================================
# Every horizontal capability LeadFlow does NOT own lives behind this gateway:
# sdk-lead-capture, sdk-assignment, sdk-sla, sdk-notification. Read by
# server/src/config/env.ts and used by services/projexcloud/SdkGatewayClient.ts.
#
# Request shape the client sends:
#   URL     {PROJEXCLOUD_GATEWAY_URL}/{sdk}{path}
#           e.g. https://cloud.projexlight.com/sdk-sla/v1/response-clocks/evaluate
#   Headers x-api-key:       PROJEXCLOUD_API_KEY    (the credential — see below)
#           x-tenant-id:     PROJEXCLOUD_TENANT_ID  (scope; sent only when set)
#           x-app-id:        PROJEXCLOUD_APP_ID     (scope; sent only when set)
#           Idempotency-Key: <stable key>           (every mutating call)
#           x-correlation-id:<uuid>                 (joins the upstream trace)
#
# AUTH IS THE API KEY, NOT A USER TOKEN. These calls are server-to-server:
# the gateway authenticates LeadFlow-the-application via x-api-key, and the
# scope it acts within travels in x-tenant-id (plus x-app-id where the gateway
# distinguishes several apps under one tenant). The caller's session JWT is
# deliberately NOT forwarded — it is minted by LeadFlow's own auth for
# LeadFlow's own routes, the gateway is not its audience, and handing a
# user-bearer token to a third party widens its blast radius for no gain.
#
# ⚠️ BOTH URL AND KEY MUST BE NON-EMPTY for the gateway to be used at all.
# While either is blank, every caller takes its documented LOCAL FALLBACK: SLA
# verdicts come from the wall clock instead of the business calendar, routing
# falls back to rule-match then round-robin, and alerts are raised but stay
# state=pending. That degradation is deliberate and loses nothing, but it is not
# the real thing. Do NOT put a placeholder in the key: a non-empty fake flips
# isConfigured() to true and turns every SDK call into a 502 UPSTREAM_UNAVAILABLE
# instead of a clean fallback.
# BOTH TARGETS ARE SUPPORTED. Switch with one line here, or override per run:
#   npm run dev:sdk-cloud    → https://cloud.projexlight.com
#   npm run dev:sdk-local    → http://localhost:3500  (ProjexCloud api-gateway)
# A shell-provided value wins, because dotenv never overwrites an existing
# process.env entry, so those scripts need no file edits.
PROJEXCLOUD_GATEWAY_URL=https://cloud.projexlight.com
# Each target has its OWN key — a cloud key will not authenticate against the
# local gateway and vice versa. Change this when you change the URL.
PROJEXCLOUD_API_KEY=
PROJEXCLOUD_TENANT_ID=
# Optional. Only needed when the gateway hosts more than one application under a
# tenant and scopes on both. Leave blank and the x-app-id header is omitted
# entirely, which is correct for a gateway that scopes by tenant alone.
PROJEXCLOUD_APP_ID=
PROJEXCLOUD_TIMEOUT_MS=8000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=dev

# ============================================
# OPTIONAL SERVICES (uncomment if needed)
# ============================================

# Email Configuration
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_email_password

# AWS S3 Storage
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your_bucket_name

# Redis Cache
# REDIS_CACHE_HOST=localhost
# REDIS_CACHE_PORT=6379

# ============================================
# IMPORTANT NOTES
# ============================================

# 1. NEVER commit the .env file to version control
# 2. Add .env to your .gitignore file
# 3. Use strong, unique passwords for production
# 4. Update JWT_SECRET with a secure random string
# 5. Configure database credentials before running the application
