# Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Database: postgresql
# PostgreSQL Configuration (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ⚡ Quick Start: These defaults work with docker-compose.yml
# Just run: cp .env.example .env && docker-compose up -d

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# EXPRESS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# ============================================
# TESTING CONFIGURATION
# ============================================
TEST_DB_NAME=leadflow_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================
# OPTIONAL SERVICES (uncomment if needed)
# ============================================
# Email — account lifecycle (verification, invitation). Optional: with no
# provider configured the sends are recorded as `skipped`, which is a valid
# deployment state, not an error.
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
# EMAIL_FROM_NAME=LeadFlow
# APP_BASE_URL=http://localhost:5173
# EMAIL_TIMEOUT_MS=10000
# EMAIL_VERIFICATION_REQUIRED=false

# Email — pre-send address verification (platform/email/addressVerification.ts).
# ON by default in 'enforce': syntax, reserved/placeholder/disposable policy and
# an MX lookup run before every send, and an address that cannot receive mail is
# refused rather than handed to the provider to bounce.
#   enforce = refuse undeliverable   warn = check and record, send anyway
#   off     = syntax only, no DNS
# EMAIL_ADDRESS_CHECK_MODE=enforce
# EMAIL_DNS_TIMEOUT_MS=5000
# Blocked verdicts that are policy rather than fact. A placeholder (test@,
# demo@) and a throwaway inbox are reachable; refusing them protects sending
# reputation on bulk imports. Role addresses (sales@, info@) are NOT refused —
# they are the correct address for a great deal of B2B.
# EMAIL_BLOCK_PLACEHOLDER=true
# EMAIL_BLOCK_DISPOSABLE=true
# EMAIL_BLOCK_ROLE=false
# EMAIL_DISPOSABLE_DOMAINS=extra-throwaway.example,another.example
# SMTP RCPT probing — asks the mail server whether the specific mailbox exists.
# OFF, and it should stay off unless this host has outbound port 25: cloud
# networks (including EC2) block it, so every check would burn its timeout and
# return `unknown`. It also costs sender reputation, and catch-all domains
# answer 250 to everything, so the answer is often a lie.
# EMAIL_SMTP_PROBE=false
# EMAIL_SMTP_PROBE_TIMEOUT_MS=8000
# EMAIL_SMTP_PROBE_FROM=postmaster@yourdomain.com
# EMAIL_SMTP_HELO_NAME=yourdomain.com
# How long a verdict is kept before it is asked again. Undeliverable expires
# faster than deliverable: a domain acquires an MX record the day its owner
# finishes setting up mail, and a month-long cache would keep refusing them.
# EMAIL_CACHE_TTL_DELIVERABLE_MS=2592000000
# EMAIL_CACHE_TTL_UNDELIVERABLE_MS=259200000
# EMAIL_CACHE_TTL_RISKY_MS=86400000
# EMAIL_CACHE_TTL_UNKNOWN_MS=300000
# EMAIL_CACHE_TTL_MX_MS=21600000

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your_bucket_name

# REDIS_CACHE_HOST=localhost
# REDIS_CACHE_PORT=6379

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit the .env file to version control
# 2. Add .env to your .gitignore file
# 3. Use strong, unique passwords for production
# 4. Update JWT_SECRET with a secure random string
# 5. Configure database credentials before running the application

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ProjexLight MCP Server Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# These variables are auto-generated from encrypted config (mcp-config.json)
# DO NOT edit PROJEXLIGHT_* variables - they will be overwritten
# You CAN edit MODEL_OVERRIDE_* variables to customize LLM models

# Platform API (Auto-generated - DO NOT EDIT)
# URL is set based on server environment: dev.projexlight.com (dev) or api.projexlight.com (prod)
PROJEXLIGHT_API_URL=https://api.projexlight.com
PROJEXLIGHT_API_KEY=<will_be_decrypted_from_mcp-config.json>
PROJEXLIGHT_PROJECT_ID=894bc4c8-4cfb-407d-9e86-234b69490275

# LLM Configuration (Auto-generated defaults)
LLM_PROVIDER=<will_be_decrypted>
LLM_API_KEY=<will_be_decrypted>
LLM_MODEL_REVIEW=<will_be_decrypted>
LLM_MODEL_EMBEDDING=<will_be_decrypted>
LLM_MODEL_AUTOFIX=<will_be_decrypted>
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.1

# Model Overrides (OPTIONAL - Uncomment to override tenant defaults)
# Validate compatibility with provider before uncommenting!
# MODEL_OVERRIDE_REVIEW=gpt-3.5-turbo
# MODEL_OVERRIDE_EMBEDDING=text-embedding-3-small
# MODEL_OVERRIDE_AUTOFIX=claude-3-sonnet-20240229

# MCP Server Settings
MCP_SERVER_PORT=8766
MCP_LOG_LEVEL=INFO
MCP_AUTO_FIX_ENABLED=true
MCP_COMPLIANCE_THRESHOLD=80

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Schema Sync Agent Configuration (Multi-Developer Sync)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Enable schema sync agent to automatically detect and sync database changes
# across multiple developer containers

# Enable/disable schema sync agent (default: true)
SCHEMA_SYNC_ENABLED=true

# How often to check for schema changes (in seconds, default: 30)
SCHEMA_SYNC_INTERVAL=30

# Auto-apply incoming migrations from other developers (default: false)
# Set to true to automatically apply schema changes without manual approval
# WARNING: Set to false in production for manual review of changes
AUTO_APPLY_MIGRATIONS=false

# Developer identifier (auto-generated if empty, can be overridden)
# This uniquely identifies your local development environment
# Example: DEVELOPER_ID=john-doe or DEVELOPER_ID=dev-container-1
DEVELOPER_ID=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
