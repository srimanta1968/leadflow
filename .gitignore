# =====================================================
# Root .gitignore - LeadFlow
# Generated by ProjexLight CLI Export
# =====================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local
*.env

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (installed locally)
node_modules/
vendor/
__pycache__/
*.pyc
venv/
.venv/

# Build outputs
dist/
build/
out/
target/
bin/
obj/

# Test coverage
coverage/
.nyc_output/
htmlcov/

# Docker
docker-compose.override.yml

# Database files (local)
*.sqlite
*.sqlite3
*.db
# Anchored. A bare `data/` matches a directory of that name at ANY depth, and it
# was silently swallowing client/src/design-system/data — source, not a database.
# The commit appeared to succeed and the components simply were not in it.
/data/
mcp-server/data/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (optional - uncomment if not using)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated documentation
docs/_build/

# Secrets and keys
*.pem
*.key
credentials.json
serviceAccount.json

# ProjexLight per-developer session/token files — NEVER commit these.
# Each developer has their OWN session token; committing them causes merge
# conflicts across developers and leaks the token into the shared repo/history.
# They are regenerated locally on every CLI export.
.projexlight/config.json
mcp-server/mcp-config.json
mcp-server/.env
.projexlight/context/task-list.json
.projexlight/reports/
.projexlight/sprint-progress/
.claude/logs/
.claude/cache/
.claude/.session/

# Dev MCP schema mirror (per-developer, re-mirrored from ProjexLight every session).
# This is a local READ-ONLY snapshot the MCP keeps fresh at runtime — NOT the
# committed source of truth (.projexlight/schemas/ is). Committing it causes
# cross-developer merge conflicts. Note the trailing slash: this ignores the
# singular schema/ mirror only, never the plural schemas/ source of truth.
.projexlight/schema/
.projexlight/context/schema_sync_state_*.json

# MCP local cache (regenerated at runtime)
.mcp-cache/

# Test results (regenerated on every run)
test-results/

# MCP feedback history (regenerated locally)
mcp-server/feedback/history/

# Storybook static build
client/storybook-static/
deploy/leadflow.env

# Per-task learning notes written by the tooling. Machine-generated, rewritten
# on every run, and of no value to anyone reading the repository — they were
# tracked, so ignoring alone would not have stopped them reappearing in diffs.
learning/

# Setup notes that carry live account credentials. A password committed to a
# repository is a password published, and the QA roster here is for the real
# production host — not a sample. Ignored as a DIRECTORY so a second file added
# beside the first is covered without anyone remembering to extend this.
docs/setup/user/
