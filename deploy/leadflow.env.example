# LeadFlow production environment.
#
#   cp leadflow.env.example leadflow.env   and fill in every CHANGE_ME.
#
# leadflow.env is gitignored. Nothing secret belongs in this file.
#
# READ THIS BEFORE DEPLOYING. Every variable the server reads has a DEFAULT and
# nothing throws when one is missing — server/src/config/env.ts falls back
# rather than refusing to start. That is convenient in development and
# dangerous here: an unset JWT_SECRET silently becomes the literal string
# 'your-secret-key', and an unset DB_PASSWORD becomes 'postgres'. A production
# process will boot, serve traffic and pass its health check with both. Anything
# marked REQUIRED below has no safe default, and deploy.sh refuses to start if
# one is still CHANGE_ME.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
APP_NAME=LeadFlow

# ─── Security — REQUIRED ────────────────────────────────────────────────────
# Generate, never reuse a development value:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d
# 10 is the development default. 12 is the sane production floor; each
# increment doubles the work an offline attacker must do per guess.
BCRYPT_ROUNDS=12

# ─── Database ───────────────────────────────────────────────────────────────
# projexcloud_pg is reached BY CONTAINER NAME over the shared Docker network.
# It publishes no host port, so localhost cannot work from inside the container.
# The database is LeadFlow's OWN; the SERVER is shared with ProjexCloud.
DB_HOST=projexcloud_pg
DB_PORT=5432
DB_NAME=leadflow_db
DB_USER=postgres
# REQUIRED — defaults to 'postgres' if unset
DB_PASSWORD=CHANGE_ME
# false: traffic never leaves the Docker network
DB_SSL=false
DB_POOL_MIN=2
# 10 in dev; raised for concurrent prod traffic
DB_POOL_MAX=20

# ─── ProjexCloud SDK gateway ────────────────────────────────────────────────
# The PUBLIC origin, not the container. The gateway terminates TLS and enforces
# tenancy at its edge, and addressing the container directly skips both.
PROJEXCLOUD_GATEWAY_URL=https://cloud.projexlight.com
# REQUIRED — every SDK call 401s without it
PROJEXCLOUD_API_KEY=CHANGE_ME
# REQUIRED — the tenant LeadFlow writes into
PROJEXCLOUD_TENANT_ID=CHANGE_ME
# REQUIRED — scopes role templates and policy.
# THE SLUG FROM signup-tenant (e.g. acme-inc-304d62), NOT a UUID. Role templates
# and consent purposes are FK'd to `tenant.app`, and that is the row signup
# creates. Putting the api_keys.application UUID here instead lets everything
# boot and fails only role provisioning, every time, with
# role_template_app_id_fkey — see PROJEXCLOUD_KEY_APP_ID below.
PROJEXCLOUD_APP_ID=CHANGE_ME
# The api_keys.application UUID, a DIFFERENT id space. Only the API key is
# minted against it. Written by provision-projexcloud.sh; nothing reads it at
# runtime, and it is kept so a key rotation knows which application to use.
PROJEXCLOUD_KEY_APP_ID=
PROJEXCLOUD_TIMEOUT_MS=8000

# Optional. Empty is a valid, meaningful value for each of these.
# only when a customer has a second app
PROJEXCLOUD_ROOT_TENANT_ID=
# empty until ProjexCloud is the identity authority
PROJEXCLOUD_IDENTITY_URL=
# falls back to APP_ID, which is usually right
PROJEXCLOUD_AUDIENCE=
PROJEXCLOUD_CLOCK_TOLERANCE_SEC=60
PROJEXCLOUD_JWKS_TTL_MS=600000

# Webhooks. With no receiver URL the app logs that it did not register and
# carries on — inbound events simply never arrive.
PROJEXCLOUD_WEBHOOK_RECEIVER_URL=https://leadflow.projexlight.com/api/events/receive
# REQUIRED if a receiver URL is set
PROJEXCLOUD_WEBHOOK_SECRET=CHANGE_ME
PROJEXCLOUD_WEBHOOK_SIGNING_KEY_REF=

# Provisioned upstream; leave empty until ProjexCloud issues them.
PROJEXCLOUD_CAPTURE_POLICY_ID=
PROJEXCLOUD_STEWARD_ROUTE_ID=

# ─── Account-lifecycle email ────────────────────────────────────────────────
# NOT a path to the customer. Every message to a prospect goes through the
# channel decision and out via sdk-notification; this carries only the three
# things that follow from somebody acting on an account — confirm your address,
# accept your invitation, reset your password.
#
# Leaving these empty is a VALID deployment. Sends are then recorded as
# 'skipped' rather than failed, and the only thing that breaks is that an
# invited colleague has no way into their account.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=welcome@projexlight.com
EMAIL_FROM_NAME=LeadFlow
# Where a link in an email points. The BROWSER origin — the API origin would
# 404 in a mail client. Defaults to the first CORS_ORIGIN.
APP_BASE_URL=https://leadflow.projexlight.com
EMAIL_TIMEOUT_MS=10000
# Off by default and deliberately opt-in: turning it on before a provider is
# configured locks every new account out of a product that had been working.
EMAIL_VERIFICATION_REQUIRED=false

# ─── HTTP ───────────────────────────────────────────────────────────────────
# The browser origin only. The dev default is localhost:5173, which in
# production would reject every real request.
CORS_ORIGIN=https://leadflow.projexlight.com
BODY_PARSER_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=900000
# 100 in dev; a shared office NATs to one IP
RATE_LIMIT_MAX_REQUESTS=300

# ─── Logging ────────────────────────────────────────────────────────────────
# 'debug' in dev logs request bodies
LOG_LEVEL=info
LOG_FORMAT=combined

# ─── Background workers ─────────────────────────────────────────────────────
OUTBOX_TICK_MS=15000
DATA_REVIEW_SWEEP_MS=900000

# ─── AI guardrails ──────────────────────────────────────────────────────────
# 'true' halts all AI capability immediately
AI_KILL_SWITCH=false
AI_KILL_SWITCH_FLAG_ID=
AI_KILL_SWITCH_TTL_MS=30000
AI_CAPABILITY_TOKEN_TTL_MS=300000
AI_TOKEN_BUDGET_PER_PERIOD=100000
AI_CONSENT_LOCAL_ONLY=false
AI_RECORDING_CONSENT_LOCAL_ONLY=false

# ─── Channel decision engine ────────────────────────────────────────────────
CHANNEL_DECISION_CONCURRENCY=8
CHANNEL_DECISION_BULK_BUDGET_MS=20000
CHANNEL_DECISION_INSERT_BATCH=500
CHANNEL_DECISION_MAX_AUDIENCE=50000

# ─── Development seeds — LEAVE EMPTY IN PRODUCTION ──────────────────────────
# devSeed.ts refuses to run when NODE_ENV=production, so these are inert here.
# They are listed so nobody copies a development file forward and ships known
# credentials without noticing.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_STEWARD_EMAIL=
DEV_STEWARD_PASSWORD=
DEV_PRIVACY_EMAIL=
DEV_PRIVACY_PASSWORD=

# ─── Deploy tooling ─────────────────────────────────────────────────────────
LEADFLOW_DB_NAME=leadflow_db
LEADFLOW_DB_USER=postgres
# must match DB_PASSWORD above
LEADFLOW_DB_PASSWORD=CHANGE_ME
# set to a build number so rollback has a target
LEADFLOW_TAG=latest
