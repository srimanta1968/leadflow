# LeadFlow production environment. Copy to leadflow.env on the host and fill in.
# leadflow.env is gitignored — secrets never enter the repository.

# ProjexCloud SDK gateway, its PUBLIC origin. The gateway terminates TLS and
# enforces tenancy at its edge; talking to the container directly skips both.
PROJEXCLOUD_GATEWAY_URL=https://cloud.projexlight.com

# Shared Postgres server, LeadFlow's own database. projexcloud_pg publishes no
# host port, so it is reachable only by container name over the shared network.
LEADFLOW_DB_NAME=leadflow_db
LEADFLOW_DB_USER=postgres
LEADFLOW_DB_PASSWORD=CHANGE_ME

# Image tag deployed. Set to a build number rather than `latest` when you want
# `deploy.sh rollback` to have somewhere to return to.
LEADFLOW_TAG=latest

# Secrets — generate, never reuse a development value.
JWT_SECRET=CHANGE_ME
